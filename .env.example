# ---------------------------------------------------------------------------
# Webhook Automation Hub - example environment
# Copy to backend/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
PUBLIC_BASE_URL=http://localhost:8000   # used to build the webhook URL shown in the UI
FRONTEND_URL=http://localhost:5173

# --- Database ----------------------------------------------------------------
# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/webhook_hub
DATABASE_URL=sqlite:///./webhook_hub.db

# --- Security ----------------------------------------------------------------
# Signs session tokens and derives the key used to encrypt action credentials
# (Discord webhook URLs, Telegram bot tokens) at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allow registration of new accounts (turn off once your own account exists).
ALLOW_REGISTRATION=true

# --- Outbound actions ---------------------------------------------------------
# Largest accepted webhook payload, in bytes (64 KiB).
MAX_PAYLOAD_BYTES=65536
# Timeout for a single outbound action call, in seconds.
ACTION_TIMEOUT_SECONDS=10
# Attempts per execution, including the first one (1-5).
MAX_ATTEMPTS=3
# Outbound requests to private/loopback addresses are refused unless this is
# true. Keep it false in production: it is the SSRF guard.
ALLOW_PRIVATE_NETWORK_TARGETS=false
